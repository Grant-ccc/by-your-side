# Copying is optional: npm run setup:local creates random local credentials.
# Never use these placeholders for a deployed service.
API_HOST=127.0.0.1
API_PORT=17401
WEB_PORT=17400
DB_HOST=127.0.0.1
DB_PORT=3307
DB_NAME=by_your_side
DB_USER=by_your_side
DB_PASSWORD=replace_with_a_random_local_password
MYSQL_ROOT_PASSWORD=replace_with_a_different_random_local_password

# Backend only. Fill locally; never commit the real key. Restart npm run dev after editing.
DEEPSEEK_API_KEY=
AI_MODEL=deepseek-flash
# Text generation only; excludes images, hosting and other services.
AI_MONTHLY_LIMIT_CNY=20
